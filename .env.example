# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Upstream / integración (placeholders; valores reales solo en secret manager / CI)
AFFINITY_API_BASE_URL=
AFFINITY_API_TIMEOUT_MS=15000

# Política: URLs de documentos deben ser firmadas de corta duración (no exponer rutas internas)
DOCUMENT_SIGNED_URL_TTL_SECONDS=300

# Opcional: correlación con gateway / front
# REQUEST_ID_HEADER=x-request-id
